{
  "name": "ai-term",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "build:notifier": "node scripts/build-notifier.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true
  },
  "dependencies": {
    "@ai-sdk/azure": "4.0.101",
    "@napi-rs/keyring": "2.1.1",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "ai": "7.0.140",
    "node-pty": "1.2.0-beta.15"
  }
}
