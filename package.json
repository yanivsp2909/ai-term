{
  "name": "ai-term",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "build:notifier": "node scripts/build-notifier.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "app:dev": "npm run build && npm run app:build && electron-vite preview --skipBuild --config app/electron.vite.config.ts",
    "app:build": "electron-vite build --config app/electron.vite.config.ts",
    "app:test": "playwright test --config app/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true,
    "electron@44.7.2": true
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/azure": "4.0.101",
    "@ai-sdk/mcp": "2.0.74",
    "@ai-sdk/openai": "4.0.93",
    "@napi-rs/keyring": "2.1.1",
    "@playwright/test": "^1.64.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "7.0.140",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "node-pty": "1.2.0-beta.15",
    "react-dom": "^19.3.1"
  },
  "main": "app/out/main/index.js"
}
